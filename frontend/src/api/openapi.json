          "displayName" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "INDIVIDUAL", "BUSINESS" ]
          },
          "phone" : {
            "type" : "string"
          }
        },
        "required" : [ "contactEmail", "displayName", "kind" ]
      },
      "CustomerProfileRequest" : {
        "type" : "object",
        "properties" : {
          "contactEmail" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "displayName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "INDIVIDUAL", "BUSINESS" ]
          },
          "phone" : {
            "type" : "string",
