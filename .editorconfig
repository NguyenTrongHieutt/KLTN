root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Spring Initializr style for the backend.
[*.{java,xml}]
indent_style = tab
indent_size = 4

[*.{sql,properties}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
