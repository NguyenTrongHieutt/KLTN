# The dev accounts compose.integrations.yaml gives the backend. Copy this file to deploy/.env (ignored
# by git) and fill in the values: none of them is a secret, but they belong to one environment.

# The dev Platform App (GitHub › vibefix-dev › Settings › GitHub Apps) and its installation on
# vibefix-dev, the number at the end of the installation's settings URL.
VIBEFIX_PLATFORM_APP_ID=
VIBEFIX_PLATFORM_APP_INSTALLATION_ID=

# The dev Merge App; each Customer installs it on their own Source Repository.
VIBEFIX_MERGE_APP_ID=

# The dev VNPay sandbox merchant's terminal code (vnp_TmnCode).
VIBEFIX_VNPAY_TMN_CODE=

# Required, read by compose.yaml (AD-46, Story 23.3, deploy/README.md): the one vibefix-dev repository that
# may run GitHub Actions, the private runner. Empty, every new Code Job setup waits and the sweep alerts
# Administrators with github.platform_drift.
VIBEFIX_GITHUB_RUNNER_REPOSITORY=vibefix-runner
